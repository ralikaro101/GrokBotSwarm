DISCORD_TOKEN=
DISCORD_PREFIX=!
MT5_BRIDGE_URL=http://127.0.0.1:8765
MT5_BRIDGE_TOKEN=
SWARM_AUTO=off
SWARM_CYCLE_SECONDS=300
# Use a fixed lot size when this is 0. Set a positive value (for example 0.25)
# to risk that percentage of live account equity at each trade's stop loss.
SWARM_RISK_PERCENT=0
# Persistent per-symbol learning guard. A symbol remains probationary until this
# many closed trades are synced from MT5, then must meet the profit-factor test.
SWARM_LEARNING_MIN_TRADES=30
SWARM_LEARNING_MIN_PROFIT_FACTOR=1.05
# US500 trades are allowed only during this New York cash-session window.
SWARM_SESSION_TIMEZONE=America/New_York
SWARM_US500_SESSION_START_HOUR=9
SWARM_US500_SESSION_START_MINUTE=30
SWARM_US500_SESSION_END_HOUR=16
SWARM_US500_SESSION_END_MINUTE=0
SWARM_US500_MAX_VIX=30
# XAUUSD: after +3% favorable price movement, trail the stop one percentage
# point behind current price (at +3% lock +2%; at +4% lock +3%).
SWARM_XAU_TRAIL_TRIGGER_PERCENT=3
SWARM_XAU_TRAIL_GAP_PERCENT=1
SWARM_ORDER_VOLUME=0.01
# Close all open positions and block new entries from this Friday cutoff
# through Sunday. Times use SWARM_WEEKEND_TIMEZONE.
SWARM_WEEKEND_TIMEZONE=UTC
SWARM_WEEKEND_CLOSE_FRIDAY_HOUR=20
SWARM_WEEKEND_CLOSE_FRIDAY_MINUTE=0
# Optional per-symbol overrides, for example broker minimums:
# SWARM_ORDER_VOLUMES=USTEC:0.10,US500:0.10
# Optional VPS-only Kronos mode: off, shadow, or gate.
SWARM_KRONOS_SHADOW=off
SWARM_KRONOS_MODE=off
KRONOS_HOME=/home/ubuntu/Kronos
