MT5_BIND_HOST=127.0.0.1
MT5_BRIDGE_PORT=8765
MT5_BRIDGE_TOKEN=
MT5_SYMBOLS=EURUSD,GBPUSD,USDCHF,AUDUSD
# Must be at least as high as the largest configured order volume.
MT5_MAX_VOLUME=0.10
MT5_MAX_POSITIONS=3
MT5_MAX_DAILY_LOSS=10
# Performance protection: evaluate recent closed trades and pause a symbol
# after repeated losses for a temporary cooldown.
MT5_PERFORMANCE_WINDOW_DAYS=7
MT5_PERFORMANCE_MIN_TRADES=5
MT5_PERFORMANCE_LOSS_THRESHOLD=3
MT5_PERFORMANCE_COOLDOWN_HOURS=12
MT5_MAX_SPREAD=0.002
# Optional per-symbol overrides. Values use the symbol's native price units.
# These example limits should be reviewed against your broker's normal spreads.
MT5_MAX_SPREADS=XAUUSD:0.80,BTCUSD:20,USTEC:3,US500:2
